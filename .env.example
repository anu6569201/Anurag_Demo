# Public values only. Vite inlines every VITE_ variable into the browser bundle.
# Never put secrets, tokens, or private keys in this file.
#
# Leave this empty in local development. Vite proxies /api to the Flask server
# at http://127.0.0.1:5001, so the browser stays on the Vite origin.
# Set an http(s) origin with no credentials when the API is hosted separately.
# Production requires https.
VITE_API_BASE_URL=
